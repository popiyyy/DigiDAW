# InfluxDB 2.7 Initialization Config
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=
INFLUXDB_ORG=digidaw-org
INFLUXDB_BUCKET=room_telemetry
INFLUXDB_ADMIN_TOKEN=
